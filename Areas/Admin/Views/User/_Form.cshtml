@using Microsoft.AspNetCore.Mvc.Rendering
@using Group1Blackboard.Models
@model Group1Blackboard.Models.AppUser

@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<form asp-action="@action" method="post" class="admin-validation-form col-lg-7 col-xl-6" novalidate>
    @if (action == "Edit")
    {
        <input type="hidden" asp-for="AppUserID" />
    }
    else
    {
        <input type="hidden" name="AppUserID" value="0" />
    }
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <p class="text-danger" data-client-validation-summary role="alert" hidden>Please correct the errors below and save again.</p>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" aria-describedby="Name-error-message" />
        <span asp-validation-for="Name" id="Name-error-message" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DOB" class="form-label"></label>
        <input asp-for="DOB" class="form-control" aria-describedby="DOB-error-message" />
        <span asp-validation-for="DOB" id="DOB-error-message" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" aria-describedby="Email-error-message" />
        <span asp-validation-for="Email" id="Email-error-message" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SSN" class="form-label"></label>
        <input asp-for="SSN" class="form-control" aria-describedby="SSN-error-message" placeholder="000-00-0000" />
        <span asp-validation-for="SSN" id="SSN-error-message" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" asp-items="@(new SelectList(AppUser.Roles))" class="form-select" aria-describedby="Role-error-message">
            <option value="">-- Select a user type --</option>
        </select>
        <span asp-validation-for="Role" id="Role-error-message" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
